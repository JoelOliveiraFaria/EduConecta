<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Proc_Faltas" targetNamespace="http://educonecta.pt/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Col_Proc_Faltas">
    <bpmn:participant id="Part_Proc_Faltas" name="EduConecta - Faltas e justificações" processRef="Proc_Faltas" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Faltas" name="Gestão de faltas e justificações" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_Faltas">
      <bpmn:lane id="L1_DT" name="Diretor de Turma">
        <bpmn:flowNodeRef>t_anal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mot</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_DOC" name="Docente">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_faltas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_sem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_SIS" name="Sistema EduConecta">
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notEE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notDT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_atual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_lim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_notFim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1_EE" name="Encarregado de Educação">
        <bpmn:flowNodeRef>t_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_just</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_semJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lk_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lk_in</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_consDec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_timer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Início da aula">
      <bpmn:outgoing>Proc_Faltas_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_sel" name="Selecionar turma">
      <bpmn:incoming>Proc_Faltas_f1</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_pres" name="Registar presenças">
      <bpmn:incoming>Proc_Faltas_f2</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_faltas" name="Existem faltas?">
      <bpmn:incoming>Proc_Faltas_f3</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f4</bpmn:outgoing>
      <bpmn:outgoing>Proc_Faltas_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_sem" name="Sem faltas">
      <bpmn:incoming>Proc_Faltas_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t_reg" name="Registar faltas">
      <bpmn:incoming>Proc_Faltas_f5</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_notEE" name="Notificar encarregado da falta">
      <bpmn:incoming>Proc_Faltas_f6</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_cons" name="Consultar falta">
      <bpmn:incoming>Proc_Faltas_f7</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_just" name="Pretende justificar?">
      <bpmn:incoming>Proc_Faltas_f8</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f9</bpmn:outgoing>
      <bpmn:outgoing>Proc_Faltas_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_sub" name="Submeter justificação (observações e anexo)">
      <bpmn:incoming>Proc_Faltas_f9</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_semJ" name="">
      <bpmn:incoming>Proc_Faltas_f10</bpmn:incoming>
      <bpmn:incoming>Proc_Faltas_f11</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="lk_out" name="Falta não justificada">
      <bpmn:incoming>Proc_Faltas_f12</bpmn:incoming>
      <bpmn:linkEventDefinition id="lk_out_ld" name="A" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="t_guard" name="Guardar justificação e anexo (pendente)">
      <bpmn:incoming>Proc_Faltas_f13</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_notDT" name="Notificar diretor de turma">
      <bpmn:incoming>Proc_Faltas_f14</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_anal" name="Avaliar justificação e anexo">
      <bpmn:incoming>Proc_Faltas_f15</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_dec" name="Justificação aprovada?">
      <bpmn:incoming>Proc_Faltas_f16</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f17</bpmn:outgoing>
      <bpmn:outgoing>Proc_Faltas_f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_mot" name="Indicar motivo da rejeição">
      <bpmn:incoming>Proc_Faltas_f18</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="lk_in" name="Falta não justificada">
      <bpmn:outgoing>Proc_Faltas_f20</bpmn:outgoing>
      <bpmn:linkEventDefinition id="lk_in_ld" name="A" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_merge" name="">
      <bpmn:incoming>Proc_Faltas_f17</bpmn:incoming>
      <bpmn:incoming>Proc_Faltas_f19</bpmn:incoming>
      <bpmn:incoming>Proc_Faltas_f20</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_atual" name="Atualizar estado da falta">
      <bpmn:incoming>Proc_Faltas_f21</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_lim" name="Limite de faltas atingido?">
      <bpmn:incoming>Proc_Faltas_f22</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f23</bpmn:outgoing>
      <bpmn:outgoing>Proc_Faltas_f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_alerta" name="Alertar diretor de turma">
      <bpmn:incoming>Proc_Faltas_f23</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_merge2" name="">
      <bpmn:incoming>Proc_Faltas_f24</bpmn:incoming>
      <bpmn:incoming>Proc_Faltas_f25</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_notFim" name="Notificar estado ao encarregado">
      <bpmn:incoming>Proc_Faltas_f26</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f27</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_consDec" name="Consultar decisão">
      <bpmn:incoming>Proc_Faltas_f27</bpmn:incoming>
      <bpmn:outgoing>Proc_Faltas_f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_fim" name="Processo concluído">
      <bpmn:incoming>Proc_Faltas_f28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="b_timer" name="Prazo de 3 dias úteis expirado" attachedToRef="t_sub" cancelActivity="true">
      <bpmn:outgoing>Proc_Faltas_f11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1o9zmvb">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Proc_Faltas_f1" name="" sourceRef="s1" targetRef="t_sel" />
    <bpmn:sequenceFlow id="Proc_Faltas_f2" name="" sourceRef="t_sel" targetRef="t_pres" />
    <bpmn:sequenceFlow id="Proc_Faltas_f3" name="" sourceRef="t_pres" targetRef="g_faltas" />
    <bpmn:sequenceFlow id="Proc_Faltas_f4" name="Não" sourceRef="g_faltas" targetRef="e_sem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${numFaltas == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f5" name="Sim" sourceRef="g_faltas" targetRef="t_reg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${numFaltas &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f6" name="" sourceRef="t_reg" targetRef="t_notEE" />
    <bpmn:sequenceFlow id="Proc_Faltas_f7" name="" sourceRef="t_notEE" targetRef="t_cons" />
    <bpmn:sequenceFlow id="Proc_Faltas_f8" name="" sourceRef="t_cons" targetRef="g_just" />
    <bpmn:sequenceFlow id="Proc_Faltas_f9" name="Sim" sourceRef="g_just" targetRef="t_sub">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${justificar == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f10" name="Não" sourceRef="g_just" targetRef="g_semJ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${justificar == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f13" name="" sourceRef="t_sub" targetRef="t_guard" />
    <bpmn:sequenceFlow id="Proc_Faltas_f11" name="" sourceRef="b_timer" targetRef="g_semJ" />
    <bpmn:sequenceFlow id="Proc_Faltas_f12" name="" sourceRef="g_semJ" targetRef="lk_out" />
    <bpmn:sequenceFlow id="Proc_Faltas_f14" name="" sourceRef="t_guard" targetRef="t_notDT" />
    <bpmn:sequenceFlow id="Proc_Faltas_f15" name="" sourceRef="t_notDT" targetRef="t_anal" />
    <bpmn:sequenceFlow id="Proc_Faltas_f16" name="" sourceRef="t_anal" targetRef="g_dec" />
    <bpmn:sequenceFlow id="Proc_Faltas_f17" name="Sim" sourceRef="g_dec" targetRef="g_merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao == "APROVADA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f18" name="Não" sourceRef="g_dec" targetRef="t_mot">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisao == "REJEITADA"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f19" name="" sourceRef="t_mot" targetRef="g_merge" />
    <bpmn:sequenceFlow id="Proc_Faltas_f20" name="" sourceRef="lk_in" targetRef="g_merge" />
    <bpmn:sequenceFlow id="Proc_Faltas_f21" name="" sourceRef="g_merge" targetRef="t_atual" />
    <bpmn:sequenceFlow id="Proc_Faltas_f22" name="" sourceRef="t_atual" targetRef="g_lim" />
    <bpmn:sequenceFlow id="Proc_Faltas_f23" name="Sim" sourceRef="g_lim" targetRef="t_alerta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faltasInjustificadas &gt;= limite}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f24" name="Não" sourceRef="g_lim" targetRef="g_merge2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${faltasInjustificadas &lt; limite}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Faltas_f25" name="" sourceRef="t_alerta" targetRef="g_merge2" />
    <bpmn:sequenceFlow id="Proc_Faltas_f26" name="" sourceRef="g_merge2" targetRef="t_notFim" />
    <bpmn:sequenceFlow id="Proc_Faltas_f27" name="" sourceRef="t_notFim" targetRef="t_consDec" />
    <bpmn:sequenceFlow id="Proc_Faltas_f28" name="" sourceRef="t_consDec" targetRef="e_fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_Proc_Faltas">
    <bpmndi:BPMNPlane id="Pl_Proc_Faltas" bpmnElement="Col_Proc_Faltas">
