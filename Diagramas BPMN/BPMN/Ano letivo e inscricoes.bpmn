<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Proc_AnoLetivo" targetNamespace="http://educonecta.pt/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Col_Proc_AnoLetivo">
    <bpmn:participant id="Part_Proc_AnoLetivo" name="EduConecta - Ano letivo e inscrições" processRef="Proc_AnoLetivo" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_AnoLetivo" name="Configuração do ano letivo e inscrição de alunos" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_AnoLetivo">
      <bpmn:lane id="L3_EE" name="Encarregado de Educação">
        <bpmn:flowNodeRef>e_consI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fimEE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_SIS" name="Sistema EduConecta">
        <bpmn:flowNodeRef>s_guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_criaEE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_conv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_assoc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_notif</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_ADM" name="Administrador">
        <bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_ano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_salas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_prof</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_loopA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_selAl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_exist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_criaAl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_insc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fimA</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s3" name="Início do ano letivo">
      <bpmn:outgoing>Proc_AnoLetivo_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_ano" name="Criar ano letivo">
      <bpmn:incoming>Proc_AnoLetivo_f1</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_salas" name="Criar salas e turmas">
      <bpmn:incoming>Proc_AnoLetivo_f2</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_prof" name="Associar docentes, educadores e auxiliares">
      <bpmn:incoming>Proc_AnoLetivo_f3</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_loopA" name="">
      <bpmn:incoming>Proc_AnoLetivo_f4</bpmn:incoming>
      <bpmn:incoming>Proc_AnoLetivo_f23</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_selAl" name="Selecionar ou introduzir aluno">
      <bpmn:incoming>Proc_AnoLetivo_f5</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_exist" name="Aluno já registado?">
      <bpmn:incoming>Proc_AnoLetivo_f6</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f7</bpmn:outgoing>
      <bpmn:outgoing>Proc_AnoLetivo_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_criaAl" name="Criar registo do aluno">
      <bpmn:incoming>Proc_AnoLetivo_f7</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_mA" name="">
      <bpmn:incoming>Proc_AnoLetivo_f8</bpmn:incoming>
      <bpmn:incoming>Proc_AnoLetivo_f9</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_insc" name="Inscrever aluno na sala ou turma">
      <bpmn:incoming>Proc_AnoLetivo_f10</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_guard" name="Guardar inscrição e histórico">
      <bpmn:incoming>Proc_AnoLetivo_f11</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_enc" name="Encarregado já tem conta?">
      <bpmn:incoming>Proc_AnoLetivo_f12</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f13</bpmn:outgoing>
      <bpmn:outgoing>Proc_AnoLetivo_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_criaEE" name="Criar conta com palavra-passe temporária">
      <bpmn:incoming>Proc_AnoLetivo_f13</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="s_conv" name="Enviar credenciais por email">
      <bpmn:incoming>Proc_AnoLetivo_f15</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_mE" name="">
      <bpmn:incoming>Proc_AnoLetivo_f14</bpmn:incoming>
      <bpmn:incoming>Proc_AnoLetivo_f16</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_assoc" name="Associar encarregado ao educando">
      <bpmn:incoming>Proc_AnoLetivo_f17</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="p_split" name="">
      <bpmn:incoming>Proc_AnoLetivo_f18</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f19</bpmn:outgoing>
      <bpmn:outgoing>Proc_AnoLetivo_f22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="s_notif" name="Notificar encarregado da inscrição">
      <bpmn:incoming>Proc_AnoLetivo_f19</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="e_consI" name="Consultar inscrição do educando">
      <bpmn:incoming>Proc_AnoLetivo_f20</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_fimEE" name="Encarregado informado">
      <bpmn:incoming>Proc_AnoLetivo_f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_mais" name="Mais alunos a inscrever?">
      <bpmn:incoming>Proc_AnoLetivo_f22</bpmn:incoming>
      <bpmn:outgoing>Proc_AnoLetivo_f23</bpmn:outgoing>
      <bpmn:outgoing>Proc_AnoLetivo_f24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_fimA" name="Ano letivo configurado">
      <bpmn:incoming>Proc_AnoLetivo_f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f1" name="" sourceRef="s3" targetRef="a_ano" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f2" name="" sourceRef="a_ano" targetRef="a_salas" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f3" name="" sourceRef="a_salas" targetRef="a_prof" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f4" name="" sourceRef="a_prof" targetRef="g_loopA" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f23" name="Sim" sourceRef="g_mais" targetRef="g_loopA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${maisAlunos == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f5" name="" sourceRef="g_loopA" targetRef="a_selAl" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f6" name="" sourceRef="a_selAl" targetRef="g_exist" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f7" name="Não" sourceRef="g_exist" targetRef="a_criaAl">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alunoExiste == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f8" name="Sim" sourceRef="g_exist" targetRef="g_mA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alunoExiste == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f9" name="" sourceRef="a_criaAl" targetRef="g_mA" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f10" name="" sourceRef="g_mA" targetRef="a_insc" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f11" name="" sourceRef="a_insc" targetRef="s_guard" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f12" name="" sourceRef="s_guard" targetRef="g_enc" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f13" name="Não" sourceRef="g_enc" targetRef="s_criaEE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${encarregadoTemConta == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f14" name="Sim" sourceRef="g_enc" targetRef="g_mE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${encarregadoTemConta == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f15" name="" sourceRef="s_criaEE" targetRef="s_conv" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f16" name="" sourceRef="s_conv" targetRef="g_mE" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f17" name="" sourceRef="g_mE" targetRef="s_assoc" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f18" name="" sourceRef="s_assoc" targetRef="p_split" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f19" name="" sourceRef="p_split" targetRef="s_notif" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f22" name="" sourceRef="p_split" targetRef="g_mais" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f20" name="" sourceRef="s_notif" targetRef="e_consI" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f21" name="" sourceRef="e_consI" targetRef="e_fimEE" />
    <bpmn:sequenceFlow id="Proc_AnoLetivo_f24" name="Não" sourceRef="g_mais" targetRef="e_fimA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${maisAlunos == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
