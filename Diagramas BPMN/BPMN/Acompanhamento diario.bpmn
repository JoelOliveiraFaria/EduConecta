<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Proc_Diario" targetNamespace="http://educonecta.pt/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Col_Proc_Diario">
    <bpmn:participant id="Part_Proc_Diario" name="EduConecta - Acompanhamento diário" processRef="Proc_Diario" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Diario" name="Acompanhamento diário na creche" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_Diario">
      <bpmn:lane id="L2_EE" name="Encarregado de Educação">
        <bpmn:flowNodeRef>e_tc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fim2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_SIS" name="Sistema EduConecta">
        <bpmn:flowNodeRef>s_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_res</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_EDU" name="Educador">
        <bpmn:flowNodeRef>ed_av</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_AUX" name="Auxiliar de Ação Educativa">
        <bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_sai</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s2" name="Criança entregue na creche">
      <bpmn:outgoing>Proc_Diario_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_ent" name="Registar entrada da criança">
      <bpmn:incoming>Proc_Diario_f1</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="s_ent" name="Notificar entrada ao encarregado">
      <bpmn:incoming>Proc_Diario_f2</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_loop" name="">
      <bpmn:incoming>Proc_Diario_f3</bpmn:incoming>
      <bpmn:incoming>Proc_Diario_f16</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_reg" name="Registar refeição, descanso ou higiene">
      <bpmn:incoming>Proc_Diario_f4</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_rel" name="Situação relevante?">
      <bpmn:incoming>Proc_Diario_f5</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f6</bpmn:outgoing>
      <bpmn:outgoing>Proc_Diario_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_alert" name="Alertar educador">
      <bpmn:incoming>Proc_Diario_f6</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="ed_av" name="Avaliar situação">
      <bpmn:incoming>Proc_Diario_f8</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_cont" name="Contactar encarregado?">
      <bpmn:incoming>Proc_Diario_f9</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f10</bpmn:outgoing>
      <bpmn:outgoing>Proc_Diario_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="s_urg" name="Enviar alerta ao encarregado">
      <bpmn:incoming>Proc_Diario_f10</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="e_tc" name="Tomar conhecimento">
      <bpmn:incoming>Proc_Diario_f12</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_m3" name="">
      <bpmn:incoming>Proc_Diario_f11</bpmn:incoming>
      <bpmn:incoming>Proc_Diario_f13</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_m2" name="">
      <bpmn:incoming>Proc_Diario_f7</bpmn:incoming>
      <bpmn:incoming>Proc_Diario_f14</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_fim" name="Fim do dia?">
      <bpmn:incoming>Proc_Diario_f15</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f16</bpmn:outgoing>
      <bpmn:outgoing>Proc_Diario_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a_sai" name="Registar saída da criança">
      <bpmn:incoming>Proc_Diario_f17</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="s_pub" name="Publicar resumo e notificar">
      <bpmn:incoming>Flow_171jvh4</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="e_cons" name="Consultar diário do educando">
      <bpmn:incoming>Proc_Diario_f24</bpmn:incoming>
      <bpmn:outgoing>Proc_Diario_f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_fim2" name="Dia concluído">
      <bpmn:incoming>Proc_Diario_f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_res" name="Compilar resumo diário">
      <bpmn:incoming>Proc_Diario_f18</bpmn:incoming>
      <bpmn:outgoing>Flow_171jvh4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Proc_Diario_f1" name="" sourceRef="s2" targetRef="a_ent" />
    <bpmn:sequenceFlow id="Proc_Diario_f2" name="" sourceRef="a_ent" targetRef="s_ent" />
    <bpmn:sequenceFlow id="Proc_Diario_f3" name="" sourceRef="s_ent" targetRef="g_loop" />
    <bpmn:sequenceFlow id="Proc_Diario_f16" name="Não" sourceRef="g_fim" targetRef="g_loop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fimDoDia == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f4" name="" sourceRef="g_loop" targetRef="a_reg" />
    <bpmn:sequenceFlow id="Proc_Diario_f5" name="" sourceRef="a_reg" targetRef="g_rel" />
    <bpmn:sequenceFlow id="Proc_Diario_f6" name="Sim" sourceRef="g_rel" targetRef="s_alert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${relevante == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f7" name="Não" sourceRef="g_rel" targetRef="g_m2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${relevante == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f8" name="" sourceRef="s_alert" targetRef="ed_av" />
    <bpmn:sequenceFlow id="Proc_Diario_f9" name="" sourceRef="ed_av" targetRef="g_cont" />
    <bpmn:sequenceFlow id="Proc_Diario_f10" name="Sim" sourceRef="g_cont" targetRef="s_urg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contactar == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f11" name="Não" sourceRef="g_cont" targetRef="g_m3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${contactar == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f12" name="" sourceRef="s_urg" targetRef="e_tc" />
    <bpmn:sequenceFlow id="Proc_Diario_f13" name="" sourceRef="e_tc" targetRef="g_m3" />
    <bpmn:sequenceFlow id="Proc_Diario_f14" name="" sourceRef="g_m3" targetRef="g_m2" />
    <bpmn:sequenceFlow id="Proc_Diario_f15" name="" sourceRef="g_m2" targetRef="g_fim" />
    <bpmn:sequenceFlow id="Proc_Diario_f17" name="Sim" sourceRef="g_fim" targetRef="a_sai">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fimDoDia == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Diario_f18" name="" sourceRef="a_sai" targetRef="s_res" />
    <bpmn:sequenceFlow id="Flow_171jvh4" sourceRef="s_res" targetRef="s_pub" />
    <bpmn:sequenceFlow id="Proc_Diario_f24" name="" sourceRef="s_pub" targetRef="e_cons" />
    <bpmn:sequenceFlow id="Proc_Diario_f25" name="" sourceRef="e_cons" targetRef="e_fim2" />
  </bpmn:process>
