        )

        encarregados = [
            {
                "id": str(documento["_id"]),
                "nome": documento.get("nome"),
                "telefone": documento.get("telefone", ""),
            }
            for documento in documentos
        ]

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível consultar os encarregados de educação.",
        }), 503

    return jsonify({
        "encarregados": encarregados,
        "quantidade": len(encarregados),
        "limite": 50,
    }), 200

@app.put("/alunos/<aluno_id>/encarregados/<encarregado_id>")
def associar_encarregado_aluno(aluno_id, encarregado_id):
    if not ObjectId.is_valid(aluno_id):
        return jsonify({
            "error": "invalid_student_id",
            "message": "O identificador do aluno é inválido.",
        }), 400

    if not ObjectId.is_valid(encarregado_id):
        return jsonify({
            "error": "invalid_guardian_id",
            "message": "O identificador do encarregado é inválido.",
        }), 400

    try:
        encarregado = database["encarregados_educacao"].find_one(
            {"_id": ObjectId(encarregado_id)},
            {"nome": 1},
        )

        if encarregado is None:
            return jsonify({
                "error": "guardian_not_found",
                "message": "Encarregado de educação não encontrado.",
            }), 404

        aluno = database["alunos"].find_one_and_update(
            {"_id": ObjectId(aluno_id)},
            {"$addToSet": {"encarregados_ids": encarregado["_id"]}},
            projection={"nome": 1},
            return_document=ReturnDocument.AFTER,
            upsert=False,
        )

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível associar o encarregado ao aluno.",
        }), 503

    if aluno is None:
        return jsonify({
            "error": "student_not_found",
            "message": "Aluno não encontrado.",
        }), 404

    return jsonify({
        "aluno": {
            "id": str(aluno["_id"]),
            "nome": aluno.get("nome"),
        },
        "encarregado": {
            "id": str(encarregado["_id"]),
            "nome": encarregado.get("nome"),
        },
        "message": "Associação confirmada.",
    }), 200


@app.get("/alunos/<aluno_id>/encarregados")
def listar_encarregados_aluno(aluno_id):
    if not ObjectId.is_valid(aluno_id):
        return jsonify({
            "error": "invalid_student_id",
            "message": "O identificador do aluno é inválido.",
        }), 400

    try:
        aluno = database["alunos"].find_one(
            {"_id": ObjectId(aluno_id)},
            {"nome": 1, "encarregados_ids": 1},
        )

        if aluno is None:
            return jsonify({
                "error": "student_not_found",
                "message": "Aluno não encontrado.",
            }), 404

        documentos = (
            database["encarregados_educacao"]
            .find(
                {"_id": {"$in": aluno.get("encarregados_ids", [])}},
                {"nome": 1, "telefone": 1},
            )
            .sort([("nome", 1), ("_id", 1)])
            .limit(50)
        )

        encarregados = [
            {
                "id": str(documento["_id"]),
                "nome": documento.get("nome"),
                "telefone": documento.get("telefone", ""),
            }
            for documento in documentos
        ]

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível consultar os encarregados do aluno.",
        }), 503

    return jsonify({
        "aluno": {
            "id": str(aluno["_id"]),
            "nome": aluno.get("nome"),
        },
        "encarregados": encarregados,
        "quantidade": len(encarregados),
        "limite": 50,
    }), 200

@app.get("/encarregados/<encarregado_id>/alunos")
def listar_alunos_encarregado(encarregado_id):
    if not ObjectId.is_valid(encarregado_id):
        return jsonify({
            "error": "invalid_guardian_id",
            "message": "O identificador do encarregado é inválido.",
        }), 400

    try:
        encarregado = database["encarregados_educacao"].find_one(
            {"_id": ObjectId(encarregado_id)},
            {"nome": 1},
        )

        if encarregado is None:
            return jsonify({
                "error": "guardian_not_found",
                "message": "Encarregado de educação não encontrado.",
            }), 404

        documentos = (
            database["alunos"]
            .find(
                {"encarregados_ids": encarregado["_id"]},
                {"nome": 1, "numero_processo": 1, "turma_id": 1},
            )
            .sort([("nome", 1), ("_id", 1)])
            .limit(50)
        )

        alunos = [
            {
                "id": str(documento["_id"]),
                "nome": documento.get("nome"),
                "numero_processo": documento.get("numero_processo"),
                "turma_id": (
                    str(documento["turma_id"])
                    if documento.get("turma_id") is not None
                    else None
                ),
            }
            for documento in documentos
        ]

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível consultar os alunos do encarregado.",
        }), 503

    return jsonify({
        "encarregado": {
            "id": str(encarregado["_id"]),
            "nome": encarregado.get("nome"),
        },
        "alunos": alunos,
        "quantidade": len(alunos),
        "limite": 50,
    }), 200

@app.before_request
def verificar_acesso_escolar():
    if request.endpoint is None:
        return None

    if request.endpoint in {"health", "ready"}:
        return None

    autorizacao = request.headers.get("Authorization", "")
    partes = autorizacao.split()

    if (
        len(autorizacao) > 8192
        or len(partes) != 2
        or partes[0].lower() != "bearer"
    ):
        return jsonify({
            "error": "authentication_required",
            "message": "É necessário iniciar sessão.",
        }), 401, {"WWW-Authenticate": "Bearer"}

    pedido = Request(
        "http://auth:8000/me",
        headers={"Authorization": f"Bearer {partes[1]}"},
        method="GET",
    )

    try:
        with urlopen(pedido, timeout=5) as resposta:
            utilizador = json.loads(resposta.read().decode("utf-8"))

    except HTTPError as erro:
        codigo = erro.code
        erro.close()

        if codigo == 401:
            return jsonify({
                "error": "invalid_session",
                "message": "Sessão inválida ou expirada. Inicia sessão novamente.",
            }), 401, {"WWW-Authenticate": "Bearer"}

        if codigo == 403:
            return jsonify({
                "error": "account_inactive",
                "message": "A conta não está ativa.",
            }), 403

        return jsonify({
            "error": "authentication_unavailable",
            "message": "Não foi possível verificar a sessão.",
        }), 503

    except (URLError, OSError, ValueError, UnicodeError):
        return jsonify({
            "error": "authentication_unavailable",
            "message": "O serviço de autenticação não está disponível.",
        }), 503

    if (
        not isinstance(utilizador, dict)
        or not isinstance(utilizador.get("id"), str)
        or not ObjectId.is_valid(utilizador["id"])
        or utilizador.get("estado") != "ativo"
        or not isinstance(utilizador.get("perfil"), str)
    ):
        return jsonify({
            "error": "authentication_unavailable",
            "message": "Não foi possível validar a resposta da autenticação.",
        }), 503

    g.utilizador = utilizador

    if request.endpoint == "listar_meus_alunos":
        if utilizador["perfil"] == "encarregado":
            return None

    elif utilizador["perfil"] == "admin":
        return None

    return jsonify({
        "error": "forbidden",
        "message": "Não tens permissão para realizar esta operação.",
    }), 403

@app.get("/me/alunos")
def listar_meus_alunos():
    utilizador_id = ObjectId(g.utilizador["id"])

    try:
        encarregado = database["encarregados_educacao"].find_one(
            {"utilizador_id": utilizador_id},
            {"nome": 1},
        )

        if encarregado is None:
            return jsonify({
                "error": "school_profile_not_linked",
                "message": "A conta ainda não tem um registo escolar associado.",
            }), 403

        documentos = (
            database["alunos"]
            .find(
                {"encarregados_ids": encarregado["_id"]},
                {"nome": 1, "numero_processo": 1, "turma_id": 1},
            )
            .sort([("nome", 1), ("_id", 1)])
            .limit(50)
        )

        alunos = [
            {
                "id": str(documento["_id"]),
                "nome": documento.get("nome"),
                "numero_processo": documento.get("numero_processo"),
                "turma_id": (
                    str(documento["turma_id"])
                    if documento.get("turma_id") is not None
                    else None
                ),
            }
            for documento in documentos
        ]

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível consultar os teus educandos.",
        }), 503

    return jsonify({
        "encarregado": {
            "id": str(encarregado["_id"]),
            "nome": encarregado.get("nome"),
        },
        "alunos": alunos,
        "quantidade": len(alunos),
        "limite": 50,
    }), 200


@app.after_request
def impedir_cache_dados_escolares(resposta):
    resposta.headers["Cache-Control"] = "no-store"
    return resposta


@app.put("/encarregados/<encarregado_id>/utilizador")
def associar_conta_encarregado(encarregado_id):
    if g.utilizador.get("perfil") != "admin":
        return jsonify({
            "error": "forbidden",
            "message": "Esta operação exige uma conta de administrador.",
        }), 403

    if not ObjectId.is_valid(encarregado_id):
        return jsonify({
            "error": "invalid_guardian_id",
            "message": "O identificador do encarregado é inválido.",
        }), 400

    if not request.is_json:
        return jsonify({
            "error": "unsupported_media_type",
            "message": "Envia Content-Type: application/json.",
        }), 415

    dados = request.get_json(silent=True)

    if (
        not isinstance(dados, dict)
        or set(dados) != {"utilizador_id"}
        or not isinstance(dados["utilizador_id"], str)
        or not ObjectId.is_valid(dados["utilizador_id"])
    ):
        return jsonify({
            "error": "invalid_fields",
            "message": "Envia apenas utilizador_id com um identificador válido.",
        }), 400

    conta_id = str(ObjectId(dados["utilizador_id"]))

    pedido = Request(
        f"http://auth:8000/admin/utilizadores/{conta_id}",
        headers={
            "Authorization": request.headers.get("Authorization", ""),
        },
        method="GET",
    )

    try:
        with urlopen(pedido, timeout=5) as resposta:
            conta = json.loads(resposta.read().decode("utf-8"))

    except HTTPError as erro:
        codigo = erro.code
        erro.close()

        if codigo == 404:
            return jsonify({
                "error": "user_not_found",
                "message": "A conta de utilizador não existe.",
            }), 404

        if codigo == 401:
            return jsonify({
                "error": "invalid_session",
                "message": "A sessão expirou. Inicia sessão novamente.",
            }), 401, {"WWW-Authenticate": "Bearer"}

        if codigo == 403:
            return jsonify({
                "error": "forbidden",
                "message": "Não tens permissão para consultar essa conta.",
            }), 403

        return jsonify({
            "error": "authentication_unavailable",
            "message": "Não foi possível verificar a conta.",
        }), 503

    except (URLError, OSError, ValueError, UnicodeError):
        return jsonify({
            "error": "authentication_unavailable",
            "message": "O serviço de autenticação não está disponível.",
        }), 503

    if not isinstance(conta, dict) or conta.get("id") != conta_id:
        return jsonify({
            "error": "authentication_unavailable",
            "message": "A resposta da autenticação é inválida.",
        }), 503

    if conta.get("perfil") != "encarregado":
        return jsonify({
            "error": "invalid_user_profile",
            "message": "A conta deve ter o perfil encarregado.",
        }), 409

    if conta.get("estado") != "ativo":
        return jsonify({
            "error": "account_inactive",
            "message": "A conta de utilizador não está ativa.",
        }), 409

    encarregado_oid = ObjectId(encarregado_id)
    conta_oid = ObjectId(conta_id)

    try:
        encarregado = database["encarregados_educacao"].find_one(
            {"_id": encarregado_oid},
            {"nome": 1, "utilizador_id": 1},
        )

        if encarregado is None:
            return jsonify({
                "error": "guardian_not_found",
                "message": "Encarregado de educação não encontrado.",
            }), 404

        associado = database["encarregados_educacao"].find_one_and_update(
            {
                "_id": encarregado_oid,
                "$or": [
                    {"utilizador_id": {"$exists": False}},
                    {"utilizador_id": conta_oid},
                ],
            },
            {"$set": {"utilizador_id": conta_oid}},
            projection={"nome": 1, "utilizador_id": 1},
            return_document=ReturnDocument.AFTER,
            upsert=False,
        )

        if associado is None:
            return jsonify({
                "error": "guardian_already_linked",
                "message": (
                    "O encarregado já está associado a outra conta "
                    "ou o registo foi alterado entretanto."
                ),
            }), 409

    except DuplicateKeyError:
        return jsonify({
            "error": "user_already_linked",
            "message": "Esta conta já está associada a outro encarregado.",
        }), 409

    except PyMongoError:
        return jsonify({
            "error": "database_unavailable",
            "message": "Não foi possível guardar a associação.",
        }), 503

    return jsonify({
        "message": "Conta associada ao encarregado.",
        "encarregado": {
            "id": str(associado["_id"]),
            "nome": associado.get("nome"),
            "utilizador_id": str(associado["utilizador_id"]),
        },
    }), 200