# Copiar para .env e preencher. O .env nunca vai para o repositório.

# MongoDB Atlas (o utilizador tem de ter acesso a todas as bases abaixo)
MONGO_URI=mongodb+srv://UTILIZADOR:PALAVRA-PASSE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_AUTH_DATABASE=auth_db
MONGO_ESCOLAR_DATABASE=escolar_dc
MONGO_DIARIO_DATABASE=diario_db
MONGO_COMUNICADOS_DATABASE=comunicados_db
MONGO_ASSIDUIDADE_DATABASE=educonecta_assiduidade
MONGO_NOTIFICACOES_DATABASE=educonecta_notificacoes

# RabbitMQ
RABBITMQ_USER=educonecta
RABBITMQ_PASS=trocar-por-uma-palavra-passe

# Segredos partilhados (JWT_SECRET_KEY tem de ter pelo menos 32 caracteres e é usado pelo auth e pelo gateway)
JWT_SECRET_KEY=trocar-por-um-segredo-com-pelo-menos-32-caracteres
INTERNAL_SERVICE_KEY=trocar-por-outro-segredo

# Gateway (opcional): origens autorizadas a chamar a API a partir de um browser, separadas por vírgulas.
# Só é preciso em desenvolvimento, quando o frontend corre noutra porta. Em produção fica vazio.
# CORS_ORIGINS=http://localhost:5173
