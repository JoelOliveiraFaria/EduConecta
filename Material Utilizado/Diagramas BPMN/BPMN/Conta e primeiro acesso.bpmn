<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Proc_Conta" targetNamespace="http://educonecta.pt/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Col_Proc_Conta">
    <bpmn:participant id="Part_Proc_Conta" name="EduConecta - Conta e primeiro acesso" processRef="Proc_Conta" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Conta" name="Criação de conta do encarregado e primeiro acesso" isExecutable="false">
    <bpmn:laneSet id="LS_Proc_Conta">
      <bpmn:lane id="L4_EE" name="Encarregado de Educação">
        <bpmn:flowNodeRef>u_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_npw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>u_area</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fim4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4_MAIL" name="Serviço de Email (externo)">
        <bpmn:flowNodeRef>m_env</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4_SIS" name="Sistema EduConecta">
        <bpmn:flowNodeRef>s_valD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_temp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_valPw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_mAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_conta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4_ADM" name="Administrador">
        <bpmn:flowNodeRef>s4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_assoc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s4" name="Novo encarregado de educação">
      <bpmn:outgoing>Proc_Conta_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a_dados" name="Introduzir dados do encarregado">
      <bpmn:incoming>Proc_Conta_f1</bpmn:incoming>
      <bpmn:incoming>Proc_Conta_f6</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a_assoc" name="Associar ao educando">
      <bpmn:incoming>Proc_Conta_f2</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_valD" name="Validar dados (email único, campos obrigatórios)">
      <bpmn:incoming>Proc_Conta_f3</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_val" name="Dados válidos?">
      <bpmn:incoming>Proc_Conta_f4</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f5</bpmn:outgoing>
      <bpmn:outgoing>Proc_Conta_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_env" name="Enviar email com palavra-passe temporária">
      <bpmn:incoming>Proc_Conta_f8</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="u_login" name="Iniciar sessão com email e palavra-passe">
      <bpmn:incoming>Proc_Conta_f11</bpmn:incoming>
      <bpmn:incoming>Proc_Conta_f15</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_auth" name="Autenticar credenciais">
      <bpmn:incoming>Proc_Conta_f12</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_cred" name="Credenciais válidas?">
      <bpmn:incoming>Proc_Conta_f13</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f14</bpmn:outgoing>
      <bpmn:outgoing>Proc_Conta_f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_temp" name="Primeiro login?">
      <bpmn:incoming>Proc_Conta_f14</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f16</bpmn:outgoing>
      <bpmn:outgoing>Proc_Conta_f17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_npw" name="Definir nova palavra-passe (obrigatório)">
      <bpmn:incoming>Proc_Conta_f16</bpmn:incoming>
      <bpmn:incoming>Proc_Conta_f21</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="s_valPw" name="Validar nova palavra-passe">
      <bpmn:incoming>Proc_Conta_f18</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_pw" name="Cumpre os requisitos?">
      <bpmn:incoming>Proc_Conta_f19</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f20</bpmn:outgoing>
      <bpmn:outgoing>Proc_Conta_f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_upd" name="Guardar nova palavra-passe e remover obrigação">
      <bpmn:incoming>Proc_Conta_f20</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_mAcc" name="">
      <bpmn:incoming>Proc_Conta_f17</bpmn:incoming>
      <bpmn:incoming>Proc_Conta_f22</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="u_area" name="Aceder à área do encarregado">
      <bpmn:incoming>Proc_Conta_f23</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_fim4" name="Sessão iniciada">
      <bpmn:incoming>Proc_Conta_f25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="s_gera" name="Gerar palavra-passe aleatória temporária">
      <bpmn:incoming>Proc_Conta_f7</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_conta" name="Criar conta com perfil Encarregado">
      <bpmn:incoming>Proc_Conta_f5</bpmn:incoming>
      <bpmn:outgoing>Proc_Conta_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Proc_Conta_f1" name="" sourceRef="s4" targetRef="a_dados" />
    <bpmn:sequenceFlow id="Proc_Conta_f6" name="Não" sourceRef="g_val" targetRef="a_dados">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dadosValidos == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f2" name="" sourceRef="a_dados" targetRef="a_assoc" />
    <bpmn:sequenceFlow id="Proc_Conta_f3" name="" sourceRef="a_assoc" targetRef="s_valD" />
    <bpmn:sequenceFlow id="Proc_Conta_f4" name="" sourceRef="s_valD" targetRef="g_val" />
    <bpmn:sequenceFlow id="Proc_Conta_f5" name="Sim" sourceRef="g_val" targetRef="s_conta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${dadosValidos == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f8" name="" sourceRef="s_gera" targetRef="m_env" />
    <bpmn:sequenceFlow id="Proc_Conta_f11" name="" sourceRef="m_env" targetRef="u_login" />
    <bpmn:sequenceFlow id="Proc_Conta_f15" name="Não" sourceRef="g_cred" targetRef="u_login">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${credenciaisValidas == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f12" name="" sourceRef="u_login" targetRef="s_auth" />
    <bpmn:sequenceFlow id="Proc_Conta_f13" name="" sourceRef="s_auth" targetRef="g_cred" />
    <bpmn:sequenceFlow id="Proc_Conta_f14" name="Sim" sourceRef="g_cred" targetRef="g_temp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${credenciaisValidas == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f16" name="Sim" sourceRef="g_temp" targetRef="u_npw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alteracaoObrigatoria == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f17" name="Não" sourceRef="g_temp" targetRef="g_mAcc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alteracaoObrigatoria == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f21" name="Não" sourceRef="g_pw" targetRef="u_npw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${passwordValida == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f18" name="" sourceRef="u_npw" targetRef="s_valPw" />
    <bpmn:sequenceFlow id="Proc_Conta_f19" name="" sourceRef="s_valPw" targetRef="g_pw" />
    <bpmn:sequenceFlow id="Proc_Conta_f20" name="Sim" sourceRef="g_pw" targetRef="s_upd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${passwordValida == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Proc_Conta_f22" name="" sourceRef="s_upd" targetRef="g_mAcc" />
    <bpmn:sequenceFlow id="Proc_Conta_f23" name="" sourceRef="g_mAcc" targetRef="u_area" />
    <bpmn:sequenceFlow id="Proc_Conta_f25" name="" sourceRef="u_area" targetRef="e_fim4" />
    <bpmn:sequenceFlow id="Proc_Conta_f7" name="" sourceRef="s_conta" targetRef="s_gera" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Dia_Proc_Conta">
    <bpmndi:BPMNPlane id="Pl_Proc_Conta" bpmnElement="Col_Proc_Conta">
      <bpmndi:BPMNShape id="Part_Proc_Conta_di" bpmnElement="Part_Proc_Conta" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3400" height="800" />
